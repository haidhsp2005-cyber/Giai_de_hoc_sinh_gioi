# ==============================================================================
# MẪU CẤU HÌNH API KEYS GOOGLE GEMINI (DÙNG TRÊN RENDER HOẶC MÁY CỤC BỘ)
# ==============================================================================

# Cách 1: Danh sách các key cách nhau bằng dấu phẩy
# GEMINI_API_KEYS="AIzaSyKey1,AIzaSyKey2,AIzaSyKey3"

# Cách 2: Từng key theo thứ tự đánh số
GEMINI_API_KEY_1="AIzaSyYourFirstKeyHere"
GEMINI_API_KEY_2="AIzaSyYourSecondKeyHere"
GEMINI_API_KEY_3="AIzaSyYourThirdKeyHere"

# Cấu hình Model mặc định
DEFAULT_GEMINI_MODEL=gemini-flash-latest

# Cấu hình Ollama (nếu có máy chủ Ollama từ xa)
OLLAMA_BASE_URL=http://localhost:11434
